# Порт HTTP-сервера микросервиса
SERVER_PORT=8086

# Путь к публичному ключу RSA для проверки подписи JWT
JWT_PUBLIC_KEY_PATH=../symfony_documents_flow/config/jwt/public.pem

# Подключение к RabbitMQ (events exchange)
RABBITMQ_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/
RABBITMQ_EVENTS_EXCHANGE=events

# Подключение к базе данных PostgreSQL (БД notification)
DB_HOST=localhost
DB_PORT=5434
DB_USER=root
DB_PASSWORD=password
DB_NAME=notification_db

# Timezone for storing actual Moscow wall time (civil time) in TIMESTAMP columns.
# TZ affects the Go process and container; DB_TIMEZONE sets Postgres session timezone (for NOW()).
# All conversions are centralized in internal/helper (clock.go).
TZ=Europe/Moscow
DB_TIMEZONE=Europe/Moscow


NOTIFICATION_DB_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=disable

# Конфигурация для утилиты goose
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=${NOTIFICATION_DB_URL}
GOOSE_MIGRATION_DIR=migrations

# (Опционально) Для локальной разработки без Docker
# RABBITMQ_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/
# DB_HOST=localhost
# DB_PORT=5434


# Mercure: realtime-пинги колокольчику. Секрет — тот же, что MERCURE_JWT_SECRET
# у Symfony (им же подписан хаб). Пустой секрет — пинги выключены, фронт на поллинге.
# В докере адрес переопределяет docker-compose (http://mercure/.well-known/mercure).
MERCURE_URL=http://localhost:3000/.well-known/mercure
MERCURE_JWT_SECRET=

# Web Push (закрытый браузер). Пара ключей VAPID, subject — mailto: или https:// контакта.
# Пустые ключи выключают push, колокольчик остаётся на пингах.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@localhost